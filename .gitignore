# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# IDE / editor
/.idea/
/.vscode/
*.iml
*.swp
*~
.DS_Store
# Per-machine editor state an operator's Markdown editor may drop next to
# the files it opens. Unanchored so it matches at any depth.
.obsidian/

# Local workdir / state (mwe-mcp runtime)
/work/
/work_example/
/work-bridgetest/
/.mwe-mcp.lock
*.mwe-write-in-progress

# Claude Code session artefacts (runtime locks, scheduled-task state)
/.claude/

# Secrets / env
.env
.env.*
!.env.example

# Compiled CSS. The dashboard's own stylesheet,
# `crates/mwe-dashboard/assets/tailwind.css`, IS committed: rust-embed reads
# it at compile time and Cargo cannot run the standalone tailwindcss CLI.
# Rebuild it after editing `tailwind/` with
# `tailwindcss -i tailwind/app.css -o crates/mwe-dashboard/assets/tailwind.css --minify`.
/static/tailwind.css

# Logs / temp
*.log
*.tmp
*.pid

# Test artifacts
/coverage/
/profraw/
*.profraw
*.profdata

# Playwright MCP scratch (snapshots, console logs, debug screenshots)
/.playwright-mcp/
/home-*.png
/phase*-*.png
/dogfood-*.png

# Dashboard runtime comment/submission cache (created at runtime, not source)
/.comment-md-cache/

# OS
Thumbs.db

# Local scratch, never tracked
/gitignored/
.secrets
/donotopen.tar.gz

# Local corpora and replay workdirs
/road-behind/
/work_qwen_35b/
/work_gemini_flash/
__pycache__/

# Maintainer-local material — never tracked in the public repo: the roadmap,
# the dated decision log and the per-area cards live here on this disk only.
/planning/
/notes/

# mwe-mcp smart-consumer state (per-machine: wiki_id, op-log head, checksums)
/.mwe/

# local credential for the ingest_replay harness — never commit
.ct

# Working documents between the maintainer and the assistant, in Italian —
# not product surface, so the public repo stays English.
/RIALLINEAMENTO.md
/RIALLINEAMENTO-aperti.md
/GLOSSARIO.md
/CITAZIONI.md
